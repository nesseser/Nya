local flyBV, flyBG
local function stopFly()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local hum = getHum()
	if hum then hum.PlatformStand = false end
end
local function ensureFly()
	local root = getRoot()
	if not root then return end
	if not flyBV or flyBV.Parent ~= root then
		if flyBV then flyBV:Destroy() end
		flyBV = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
	end
	if not flyBG or flyBG.Parent ~= root then
		if flyBG then flyBG:Destroy() end
		flyBG = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = root.CFrame }, root)
	end
end
local function updateFly()
	local hum, root = getHum(), getRoot()
	if not (hum and root) then return end
	ensureFly()
	hum.PlatformStand = true
	local dir = hum.MoveDirection
	local vert = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then vert -= 1 end
	local look = camera.CFrame.LookVector
	if dir.Magnitude > 0.1 then
		local fwd = Vector3.new(look.X, 0, look.Z)
		if fwd.Magnitude > 0 then
			local dot = dir:Dot(fwd.Unit)
			if dot > 0.5 then dir = dir + Vector3.new(0, look.Y * dot, 0) end
		end
	end
	flyBV.Velocity = (dir + Vector3.new(0, vert, 0)) * S.flySpeed
	flyBG.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
end


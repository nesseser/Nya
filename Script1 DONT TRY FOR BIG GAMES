		Size = UDim2.new(0, 70, 0, 24), Position = UDim2.new(1, -82, 0, 4), BackgroundTransparency = 1, Text = fmt(default),
		TextColor3 = T.accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
	}, r)
	local track = new("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 38), BackgroundColor3 = T.stroke, BorderSizePixel = 0 }, r)
	round(track, 3)
	local fill = new("Frame", { Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, track)
	round(fill, 3)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, fill)
	round(knob, 7)
	local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, -10), Text = "", BackgroundTransparency = 1 }, track)

	local function setFromX(x, final)
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = math.floor((min + (max - min) * rel) / step + 0.5) * step
		v = math.clamp(v, min, max)
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		valLbl.Text = fmt(v)
		cb(v, final)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeSlider = setFromX
			setFromX(i.Position.X, false)
		end
	end)

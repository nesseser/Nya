local function applyTheme(th)
	for k, v in pairs(th) do
		if k ~= "name" then T[k] = v end
	end
	for i = #bound, 1, -1 do
		local o, prop, key = bound[i][1], bound[i][2], bound[i][3]
		if o and o.Parent then
			o[prop] = T[key]
			if prop == "BackgroundColor3" then
				local a = alphaFor(key)
				if a ~= nil and o.BackgroundTransparency < 0.99 then o.BackgroundTransparency = a end
			end
		else
			table.remove(bound, i)
		end
	end
	for _, t in ipairs(toggleRenders) do

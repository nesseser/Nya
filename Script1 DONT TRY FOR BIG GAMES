local ents = {}
local function listHas(listStr, name)
	name = name:lower()
	for kw in listStr:lower():gmatch("[^,%s]+") do
		if name:find(kw, 1, true) then return true end
	end
	return false
end
local function entPos(inst)
	if inst:IsA("Model") then return inst:GetPivot().Position end
	return inst.Position
end
local function untrackEntity(inst)
	local o = ents[inst]
	if o then
		if o.hl then o.hl:Destroy() end
		if o.bb then o.bb:Destroy() end
		ents[inst] = nil
	end
end
local function clearEntities() for i in pairs(ents) do untrackEntity(i) end end

-- her zaman yok sayilan isimler (kayitli ayarlar bunu ezemez)
local BUILTIN_IGNORE = "frame,knob,hinge,doorway,jamb,trim,handle,hitbox,hurtbox,terrain,camera,baseplate,spawnlocation,"
	.. "wall,floor,ceiling,rafter,pillar,strip,lightstand,chandelier,window,panel,cube,mesh,decal,glow,sign,start_,end_"
local function ignored(name)
	return listHas(BUILTIN_IGNORE, name) or listHas(S.entIgnore, name)
end

-- hangi tur? entity = humanoid / tehlikeli isim, door, hide (dolap vb.), item
local function classify(inst)
	if inst:IsA("Terrain") then return nil end
	local name = inst.Name
	if not inst:IsA("Model") then
		-- yerdeki Tool'lar ve tek parca kapi / esyalar
		if inst:IsA("Tool") then
			if S.entItem and inst.Parent and not inst.Parent:FindFirstChildOfClass("Humanoid") then return "item" end
			return nil
		end
		if inst:IsA("BasePart") and not ignored(name) then
			if S.entDoor and listHas(S.entDoors, name) then return "door" end
			if S.entItem and listHas(S.entItems, name) then return "item" end
			if S.entChest and listHas(S.entChests, name) then return "chest" end
		end
		return nil
	end
	if Players:GetPlayerFromCharacter(inst) then return nil end
	if ignored(name) then return nil end
	if inst:FindFirstChildOfClass("Humanoid") then return "entity", listHas(S.entDanger, name) end
	if listHas(S.entDanger, name) then return "entity", true end
	if S.entDoor and listHas(S.entDoors, name) then return "door" end
	if S.entHide and listHas(S.entHides, name) then return "hide" end
	if S.entItem and listHas(S.entItems, name) then return "item" end
	if S.entChest and listHas(S.entChests, name) then return "chest" end
	return nil
end

-- sahte kapi: kendisi veya ust modellerinden birinin adi sahte kelimelerinden birini iceriyorsa
local function isFakeDoor(inst)
	local a = inst
	while a and a ~= workspace do
		if listHas(S.fakeWords, a.Name) then return true end
		a = a.Parent
	end
	return false
end

local CAT_ICON = { entity = "☠ ", door = "🚪 ", hide = "🗄 ", item = "★ ", chest = "📦 " }

local function makeHl(inst, color)
	return new("Highlight", {
		Adornee = inst, FillColor = color, FillTransparency = 0.55, OutlineColor = color,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, NoBind = true,
	}, gui)
end

local function trackEntity(inst, silent)
	if ents[inst] or not inst.Parent or not S.entOn then return end
	local cat, danger = classify(inst)
	if not cat then return end
	-- zaten izlenen bir modelin icindeyse atla (dolabin kapagi gibi)
	local a = inst.Parent
	while a and a ~= workspace do
		if ents[a] then return end
		a = a.Parent
	end
	local part = inst:IsA("BasePart") and inst or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	if not part then return end

	local color = cat == "entity" and (danger and T.bad or T.orange)
		or cat == "door" and T.info or cat == "hide" and T.ok or cat == "chest" and T.purple or T.warn
	local fake = cat == "door" and isFakeDoor(inst)
	if fake then color = T.bad end
	local o = { part = part, cat = cat, color = color, fake = fake }
	local shown = cat == "door" and (fake and "Sahte kapı" or "Kapı") or inst.Name
	if #shown > 18 then shown = shown:sub(1, 16) .. "…" end
	o.text = (danger and "☠ " or CAT_ICON[cat]) .. shown
	ents[inst] = o
	-- once alt parcalar izlendiyse (door frame vb.), sadece en dis kapiyi birak
	for other in pairs(ents) do
		if other ~= inst and other:IsDescendantOf(inst) then untrackEntity(other) end
	end

	if cat == "entity" and not silent then
		local myRoot = getRoot()
		local dist = myRoot and math.floor((part.Position - myRoot.Position).Magnitude + 0.5) or 0
		local prefix = (danger and "☠ TEHLİKE: " or "⚠ ") .. inst.Name .. " spawn oldu"
		local entry = notify(prefix .. " (" .. dist .. " stud)", danger and "bad" or "entity", "ent:" .. inst.Name, prefix)
		if entry.n == 1 then
			addLog("entity", inst:GetFullName() .. " spawn oldu (" .. dist .. " stud)" .. (danger and "  [TEHLIKE]" or ""))
		end
		playAlert(danger)
	end
end


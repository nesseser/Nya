local MAX_SHOW = 600 -- bundan uzaktaki hicbir sey gosterilmez / islenmez
local MAX_DOOR_HL = 24 -- Roblox ayni anda ~31 highlight cizer; en yakin kapilara verilir
local DEDUP = 8 -- ayni turden bu kadar yakin etiketlerden sadece biri gosterilir

-- etiket sadece menzile girince olusturulur, cikinca silinir (uzaktakiler hic cizilmez)
local function ensureBb(o)
	if o.bb then return end
	o.bb = new("BillboardGui", {
		Adornee = o.part, Size = UDim2.fromOffset(180, 40), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true,
	}, gui)
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0.55, 0), BackgroundTransparency = 1, Text = o.text, TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = o.color, TextStrokeTransparency = 0, Font = Enum.Font.GothamBold, TextScaled = true, NoBind = true,
	}, o.bb)
	o.distLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.new(0, 0, 0.55, 0), BackgroundTransparency = 1,
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, Font = Enum.Font.Gotham, TextScaled = true, NoBind = true,
	}, o.bb)
end
local function dropBb(o)
	if o.bb then
		o.bb:Destroy()
		o.bb, o.distLbl, o.lastDist, o.f = nil, nil, nil, nil
	end
end

local function limitFor(cat)
	local lim = cat == "entity" and S.entMax or cat == "door" and S.doorMax or S.objMax
	return math.min(lim, MAX_SHOW)
end

local function updateEntities()
	local myRoot = getRoot()
	-- 1) menzildekileri turlere ayir
	local byCat = {}
	for inst, o in pairs(ents) do
		if not inst:IsDescendantOf(workspace) then
			untrackEntity(inst)
		else
			if not o.part:IsDescendantOf(workspace) then
				dropBb(o)
				o.part = inst:IsA("BasePart") and inst or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
			end
			o.show = false
			if o.part and myRoot then
				local dist = (o.part.Position - myRoot.Position).Magnitude
				o.dist = dist
				if dist <= limitFor(o.cat) then
					local key = o.fake and "doorFake" or o.cat
					local l = byCat[key]
					if not l then l = {}; byCat[key] = l end
					l[#l + 1] = o
				end
			end
		end
	end
	-- 2) ust uste binen etiketleri ele: en yakin olan kalir (varliklar haric)
	for cat, list in pairs(byCat) do
		table.sort(list, function(a, b) return a.dist < b.dist end)
		local kept = {}
		for _, o in ipairs(list) do
			local pos = o.part.Position
			local dup = false
			if cat ~= "entity" then
				for _, k in ipairs(kept) do
					if (k - pos).Magnitude < DEDUP then dup = true; break end
				end
			end
			if not dup then
				kept[#kept + 1] = pos
				o.show = true
			end
		end
	end
	-- 3) goster / gizle
	local doors = {}
	for inst, o in pairs(ents) do
		local cat = o.cat
		if o.show then
			ensureBb(o)
			o.bb.Adornee = o.part
			-- uzaktaki yazilar kucuk, yaklastikca buyur
			local f = 1.2 - 0.75 * math.min(o.dist / limitFor(cat), 1)
			if not o.f or math.abs(f - o.f) > 0.03 then
				o.f = f
				o.bb.Size = UDim2.fromOffset(180 * f, 40 * f)
			end
			local d = math.floor(o.dist + 0.5)
			if d ~= o.lastDist then
				o.lastDist = d
				o.distLbl.Text = d .. " stud"
			end
			if cat == "entity" then
				o.wantHl = S.entHighlight
			elseif cat == "door" then
				o.wantHl = false
				if S.entDoorHl then table.insert(doors, o) end
			else
				o.wantHl = S.entObjHl
			end
		else
			dropBb(o)
			o.wantHl = false
		end
	end
	table.sort(doors, function(a, b) return a.dist < b.dist end)
	for i = 1, math.min(#doors, MAX_DOOR_HL) do doors[i].wantHl = true end
	for inst, o in pairs(ents) do
		if o.wantHl and not o.hl then
			o.hl = makeHl(inst, o.color)
		elseif not o.wantHl and o.hl then
			o.hl:Destroy()
			o.hl = nil
		end
	end
end


		registry[key] = {
			default = default, cb = cb, get = function() return curVal end,
			set = function(v)
				v = math.clamp(v, min, max)
				curVal = v
				fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
				valLbl.Text = fmt(v)
			end,
		}

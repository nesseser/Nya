local function addSlider(page, text, min, max, default, cb, step, key)
	step = step or 1
	local r = row(page, 54)
	new("TextLabel", {
		Size = UDim2.new(1, -90, 0, 24), Position = UDim2.fromOffset(12, 4), BackgroundTransparency = 1, Text = text,

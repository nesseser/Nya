			tween(sw, 0.15, { BackgroundColor3 = col })
		else
			knob.Position, sw.BackgroundColor3 = pos, col
		end
	end
	render(false)
	table.insert(toggleRenders, { sw = sw, render = render })
	local function set(v) state = v; render(true) end
	sw.MouseButton1Click:Connect(function()
		state = not state
		render(true)
		cb(state)
		markDirty()
	end)
	if key then registry[key] = { set = set, default = default, cb = cb, get = function() return state end } end
	return set
end


do
	local FILE = "HunterPanel_settings.json"
	local canFile = typeof(writefile) == "function" and typeof(readfile) == "function"
	local NO_SAVE = { flyOn = true, noclip = true, hbViz = true, autoCollect = true, entIgnore = true, killNames = true }

	local function encode()
		local data = { theme = X.themeIndex, v = {} }
		for k, r in pairs(registry) do
			if not NO_SAVE[k] and r.get then data.v[k] = r.get() end
		end
		return HttpService:JSONEncode(data)
	end
	local function apply(json)
		local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
		if not ok or type(data) ~= "table" then return false end
		if THEMES[data.theme] then
			X.themeIndex = data.theme
			applyTheme(THEMES[data.theme])
		end
		for k, v in pairs(data.v or {}) do
			local r = registry[k]
			if r and not NO_SAVE[k] and typeof(v) == typeof(r.get()) then
				r.set(v)
				r.cb(v)
			end
		end
		return true
	end

	function X.save(manual)
		if not canFile then
			if manual then notify("Dosya kaydı yok - JSON'u kopyalayıp sakla", "warn") end
			return
		end
		local ok = pcall(writefile, FILE, encode())
		if manual then notify(ok and "Ayarlar kaydedildi" or "Kaydedilemedi", ok and "ok" or "bad") end
	end
	function X.load(silent)
		if not canFile then return end
		local ok, txt = pcall(readfile, FILE)
		if ok and txt and apply(txt) then
			if not silent then notify("Ayarlar yüklendi", "ok") end
		elseif not silent then
			notify("Kayıtlı ayar yok", "warn")
		end
	end

	addButton(pSet, "💾  Şimdi kaydet", function() X.save(true) end, "accent")
	addButton(pSet, "📂  Kayıtlı ayarları yükle", function() X.load(false) end)

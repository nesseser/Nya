RunService.Stepped:Connect(function()
	local c, root, hum = getChar(), getRoot(), getHum()
	if not (c and root and hum) then return end
	if S.noclip then
		for _, p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
		if not S.flyOn then
			local v = root.AssemblyLinearVelocity
			local y = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then y = S.noclipVert
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then y = -S.noclipVert end
			root.AssemblyLinearVelocity = Vector3.new(v.X, y, v.Z)
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	local hum, root = getHum(), getRoot()
	if hum then
		if S.speedOn then
			if not X.speeding then X.speeding = true; X.cur = X.baseWalk end
			local step = S.speedRamp and S.rampRate * dt or math.huge
			X.cur = X.cur + math.clamp(S.speed - X.cur, -step, step)
			if S.speedMode == "WalkSpeed" then
				if hum.WalkSpeed ~= X.cur then hum.WalkSpeed = X.cur end
			else
				if hum.WalkSpeed ~= X.baseWalk then hum.WalkSpeed = X.baseWalk end
				local dir = hum.MoveDirection
				if root and not S.flyOn and dir.Magnitude > 0 then
					if S.speedMode == "Velocity" then
						local v = root.AssemblyLinearVelocity
						root.AssemblyLinearVelocity = Vector3.new(dir.X * X.cur, v.Y, dir.Z * X.cur)
					else
						root.CFrame = root.CFrame + dir * math.max(0, X.cur - X.baseWalk) * dt
					end
				end
			end
		else
			if X.speeding then X.speeding = false; hum.WalkSpeed = X.baseWalk end
			X.baseWalk = hum.WalkSpeed
		end
		if S.jumpOn then
			if not hum.UseJumpPower then hum.UseJumpPower = true end
			if hum.JumpPower ~= S.jump then hum.JumpPower = S.jump end
		end
		if S.godMode and hum.Health > 0 and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
		if S.flyOn then hum.PlatformStand = true end
	end
	if S.gravityOn and workspace.Gravity ~= S.gravity then workspace.Gravity = S.gravity end
	if root and hum then
		X.update(dt, hum, root)
		if hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > S.voidY + 100 then
			safePos = root.CFrame
		end
		if S.antiVoid and root.Position.Y < S.voidY and safePos then
			teleportTo(safePos + Vector3.new(0, 5, 0))
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if S.flyOn then updateFly() end
	if S.clockOn then Lighting.ClockTime = S.clockTime end
	if S.noFog then Lighting.FogEnd = 1e6 end
	if S.zoomOn and player.CameraMaxZoomDistance ~= S.zoom then player.CameraMaxZoomDistance = S.zoom end
	X.crossH.Visible, X.crossV.Visible = S.crosshair, S.crosshair
	X.stats.Visible = S.showStats
	if S.showStats and dt > 0 then
		X.fps = X.fps * 0.9 + (1 / dt) * 0.1
		X.stats.Text = string.format("FPS %d  |  Ping %d ms", X.fps, player:GetNetworkPing() * 2000)
	end
	if S.fovOn and camera.FieldOfView ~= S.fov then camera.FieldOfView = S.fov end
	if S.espOn then updateESP() end
	if S.entOn then
		X.entT = (X.entT or 0) + dt
		if X.entT >= 0.1 then -- saniyede 10 kez, boyut gecisi akici olsun
			X.entT = 0
			updateEntities()
		end
	end
	if S.hbViz then updateHbViz() end
	if S.fullbright then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 1e6
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.new(1, 1, 1)
	end
end)

UserInputService.JumpRequest:Connect(function()
	if S.infJump then
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

local mouse = player:GetMouse()
mouse.Button1Down:Connect(function()
	if S.clickTP and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and mouse.Hit then
		teleportTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 4, 0)))
	end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.K then
		main.Visible = not main.Visible
	elseif input.KeyCode == Enum.KeyCode.F then
		S.flyOn = not S.flyOn
		setFly(S.flyOn)
		if not S.flyOn then stopFly() end
	elseif input.KeyCode == Enum.KeyCode.N then
		S.noclip = not S.noclip
		setNoclip(S.noclip)
	elseif input.KeyCode == Enum.KeyCode.R and S.rQuick then
		X.quick()
	end
end)

local function hookDeath(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	hum.Died:Connect(function()
		local r = char:FindFirstChild("HumanoidRootPart")
		if r then lastDeathCF = r.CFrame end
	end)
end

local function setupChar(char)
	camera = workspace.CurrentCamera
	flyBV, flyBG, safePos = nil, nil, nil
	X.lastPos, X.speeding, X.dodging, X.hold = nil, false, false, false
	task.spawn(hookDeath, char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not root then return end
	if lastDeathCF and (pendingRevive or S.respawnAtDeath) then
		task.wait(0.15)
		char:PivotTo(lastDeathCF + Vector3.new(0, 3, 0))
		X.lastPos = nil
		if pendingRevive then notify("Öldüğün yerde yeniden doğdun", "ok") end
		pendingRevive = false
	end
	if S.flyOn then ensureFly() end
end
player.CharacterAdded:Connect(setupChar)
if player.Character then task.spawn(hookDeath, player.Character) end


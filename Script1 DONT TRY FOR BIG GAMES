local espObjs = {}
local function removeESP(plr)
	local o = espObjs[plr]
	if o then
		o.hl:Destroy()
		o.bb:Destroy()
		espObjs[plr] = nil
	end
end
local function clearESP() for plr in pairs(espObjs) do removeESP(plr) end end

local function buildESP(plr, char, root)
	local o = { char = char }
	o.hl = new("Highlight", {
		Adornee = char, FillTransparency = 0.5, OutlineColor = Color3.new(1, 1, 1),
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, NoBind = true,
	}, gui)
	o.bb = new("BillboardGui", {
		Adornee = char:FindFirstChild("Head") or root, Size = UDim2.fromOffset(200, 40),
		StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true,
	}, gui)
	o.nameLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0.55, 0), BackgroundTransparency = 1, TextStrokeTransparency = 0,
		Font = Enum.Font.GothamBold, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), NoBind = true,
	}, o.bb)
	o.distLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.new(0, 0, 0.55, 0), BackgroundTransparency = 1,
		TextStrokeTransparency = 0, Font = Enum.Font.Gotham, TextScaled = true, TextColor3 = T.warn,
	}, o.bb)
	espObjs[plr] = o
	return o
end

local function updateESP()
	local myRoot = getRoot()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and root then
				local o = espObjs[plr]
				if o and o.char ~= char then removeESP(plr); o = nil end
				if not o then o = buildESP(plr, char, root) end
				local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
				local vis = dist <= S.espMax
				local color = S.espTeam and plr.TeamColor.Color or Color3.fromRGB(255, 80, 80)
				o.hl.Enabled = vis and S.espHighlight
				o.hl.FillColor = color
				o.bb.Enabled = vis and (S.espName or S.espDist)
				o.nameLbl.Visible = S.espName
				o.nameLbl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
				o.nameLbl.TextColor3 = color
				o.distLbl.Visible = S.espDist
				o.distLbl.Text = string.format("%d stud", math.floor(dist + 0.5))
			else
				removeESP(plr)
			end
		end
	end
end

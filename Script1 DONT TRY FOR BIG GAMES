local THEME_KEYS = { "bg", "panel", "card", "stroke", "accent", "text", "sub" }
local COLOR_PROPS = { BackgroundColor3 = true, TextColor3 = true, Color = true, ScrollBarImageColor3 = true }
local bound = {}

local function colorKey(c)
	for _, k in ipairs(THEME_KEYS) do
		if T[k] == c then return k end
	end
end
local function alphaFor(key)
	if key == "bg" then return T.alphaBg end
	if key == "panel" or key == "card" then return T.alpha end
	return nil
end

local function new(class, props, parent)
	local o = Instance.new(class)
	local noBind = props.NoBind
	for k, v in pairs(props) do
		if k ~= "NoBind" then
			o[k] = v
			if not noBind and COLOR_PROPS[k] and typeof(v) == "Color3" then
				local key = colorKey(v)
				if key then
					table.insert(bound, { o, k, key })
					if k == "BackgroundColor3" and props.BackgroundTransparency == nil then
						local a = alphaFor(key)
						if a and a > 0 then o.BackgroundTransparency = a end
					end
				end
			end
		end
	end
	if parent then o.Parent = parent end
	return o
end
local function round(o, r) new("UICorner", { CornerRadius = UDim.new(0, math.min(r or 8, 3)) }, o) end
local function stroke(o, c, t)
	return new("UIStroke", { Color = c or T.stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function tween(o, time, props)
	TweenService:Create(o, TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad), props):Play()
end
local function fmt(n) return string.format("%g", n) end


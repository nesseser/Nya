		TextColor3 = T.accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
	}, r)
	local track = new("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 38), BackgroundColor3 = T.stroke, BorderSizePixel = 0 }, r)
	round(track, 3)
	local fill = new("Frame", { Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, track)
	round(fill, 3)

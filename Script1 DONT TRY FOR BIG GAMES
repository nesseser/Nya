local function playAlert(danger, force)
	if not S.soundOn and not force then return end
	if not force and os.clock() - lastAlert < 1.2 then return end
	lastAlert = os.clock()
	task.spawn(function()
		local n = danger and 3 or 1
		for i = 1, n do
			alertSound.Volume = S.soundVol
			alertSound.PlaybackSpeed = danger and (0.8 + i * 0.25) or 1.2
			alertSound.TimePosition = 0
			alertSound:Play()
			task.wait(0.17)
		end
	end)
end


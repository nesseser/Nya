local ents = {}
local function listHas(listStr, name)
	name = name:lower()
	for kw in listStr:lower():gmatch("[^,%s]+") do
		if name:find(kw, 1, true) then return true end
	end
	return false
end
local function entPos(inst)
	if inst:IsA("Model") then return inst:GetPivot().Position end
	return inst.Position
end
local function untrackEntity(inst)
	local o = ents[inst]
	if o then
		o.hl:Destroy()
		if o.bb then o.bb:Destroy() end
		ents[inst] = nil
	end
end
local function clearEntities() for i in pairs(ents) do untrackEntity(i) end end

local function trackEntity(inst)
	if ents[inst] or not inst.Parent then return end
	if not (inst:IsA("Model") or inst:IsA("BasePart")) or inst:IsA("Terrain") then return end
	if not (inst.Parent == workspace or inst.Parent:IsA("Folder")) then return end
	if inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) then return end
	if listHas(S.entIgnore, inst.Name) then return end

	local danger = listHas(S.entDanger, inst.Name)
	local mainColor = danger and T.bad or T.orange
	local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
	local o = { part = part }
	o.hl = new("Highlight", {
		Adornee = inst, FillColor = mainColor, FillTransparency = 0.4, OutlineColor = Color3.fromRGB(255, 255, 0),
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = S.entHighlight, NoBind = true,
	}, gui)
	if part then
		o.bb = new("BillboardGui", {
			Adornee = part, Size = UDim2.fromOffset(200, 44), StudsOffset = Vector3.new(0, 4, 0), AlwaysOnTop = true,
		}, gui)
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0.55, 0), BackgroundTransparency = 1, Text = (danger and "☠ " or "⚠ ") .. inst.Name,
			TextColor3 = mainColor, TextStrokeTransparency = 0, Font = Enum.Font.GothamBold, TextScaled = true, NoBind = true,
		}, o.bb)
		o.distLbl = new("TextLabel", {
			Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.new(0, 0, 0.55, 0), BackgroundTransparency = 1,
			TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, Font = Enum.Font.Gotham, TextScaled = true, NoBind = true,
		}, o.bb)
	end
	ents[inst] = o
	local myRoot = getRoot()
	local dist = myRoot and math.floor((entPos(inst) - myRoot.Position).Magnitude + 0.5) or 0
	notify((danger and "☠ TEHLİKE: " or "⚠ ") .. inst.Name .. " spawn oldu (" .. dist .. " stud)", danger and "bad" or "entity")
	addLog("entity", inst:GetFullName() .. " spawn oldu (" .. dist .. " stud)" .. (danger and "  [TEHLIKE]" or ""))
	playAlert(danger)
end

workspace.DescendantAdded:Connect(function(d)
	if not S.entOn or os.clock() - startTime < 4 then return end
	task.delay(0.15, function()
		if d.Parent then trackEntity(d) end
	end)
end)

local function updateEntities()
	local myRoot = getRoot()
	for inst, o in pairs(ents) do
		if not inst:IsDescendantOf(workspace) then
			untrackEntity(inst)
		else
			o.hl.Enabled = S.entHighlight
			if o.distLbl and myRoot then
				o.distLbl.Text = string.format("%d stud", math.floor((entPos(inst) - myRoot.Position).Magnitude + 0.5))
			end
			if o.bb and (not o.part or not o.part:IsDescendantOf(workspace)) then
				o.part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
				o.bb.Adornee = o.part
			end
		end
	end
end

